{
  "name": "webfolks-date-picker-react",
  "version": "0.2.0",
  "description": "WebFolks Date Picker for React — one date, with quick month and year selection. Desktop popover, fullscreen mobile experience, keyboard accessible, locale-aware, themeable primary color, zero dependencies.",
  "license": "MIT",
  "author": "Mykhailo Voloshyn, WebFolks.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikhailvol/webfolks-date-picker-react"
  },
  "keywords": [
    "react",
    "datepicker",
    "date-picker",
    "month-picker",
    "year-picker",
    "calendar",
    "nextjs",
    "webfolks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/styles.css dist/styles.css",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
